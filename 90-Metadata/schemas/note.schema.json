{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/second-brain/note.schema.json",
  "title": "Second Brain Note",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "knowledge",
        "experience",
        "project",
        "resource",
        "learning",
        "area",
        "inbox"
      ]
    },
    "domain": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "reviewed": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "project": {
      "type": "string"
    },
    "technology": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "resource_type": {
      "enum": [
        "article",
        "documentation",
        "repository",
        "book",
        "course",
        "video",
        "paper"
      ]
    },
    "learning_type": {
      "enum": [
        "plan",
        "session",
        "exercise",
        "assessment",
        "weekly-review"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "objective": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "week": {
      "type": "string"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "title",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string"
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}